# ===== DeepSeek LLM =====
# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=your-deepseek-api-key
# API 地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名（deepseek-v4-flash / deepseek-v4）
DEEPSEEK_MODEL=deepseek-v4-flash
# 连接超时（秒）
LLM_CONNECT_TIMEOUT=3.0
# 读取超时（秒），Agent回复可能较长
LLM_READ_TIMEOUT=30.0

# ===== 其他 LLM 提供商（AiDataAnalysisPlatform 使用）=====
# 默认提供商：deepseek / qwen / glm / siliconflow / openai_compatible
LLM_PROVIDER=deepseek
# LLM 通用参数
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ===== Qwen（阿里云通义千问）=====
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ===== GLM（智谱AI）=====
GLM_API_KEY=your-glm-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# ===== SiliconFlow（硅基流动）=====
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# ===== OpenAI 兼容接口 =====
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://your-llm-api.com/v1
LLM_MODEL=your-model-name

# ===== Qdrant 向量库 =====
# 远程模式：主机地址（当 QDRANT_LOCAL_PATH 为空时生效）
QDRANT_HOST=localhost
# 远程模式：端口
QDRANT_PORT=6333
# 本地模式：数据目录，非空时忽略 host/port，使用嵌入式模式
QDRANT_LOCAL_PATH=
# 连接超时（秒）
QDRANT_TIMEOUT=5.0
# 默认集合名（可被指针文件覆盖）
QDRANT_COLLECTION=operation_docs

# ===== Redis 会话记忆 =====
# Redis 连接地址
REDIS_URL=redis://localhost:6379/0
# 最大上下文轮数（对话历史保留轮数）
REDIS_MAX_CONTEXT_TURNS=3
# 过期时间（秒），0=永久
REDIS_TTL=0

# ===== Embedding 模型 =====
# Embedding 模型名称（默认 BAAI/bge-small-zh-v1.5）
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# 运行设备（cpu / cuda / mps）
EMBEDDING_DEVICE=cpu
# 批量处理大小
EMBEDDING_BATCH_SIZE=32
# 缓存大小（嵌入结果缓存数量）
EMBEDDING_CACHE_SIZE=10000

# ===== 检索配置 =====
# 检索返回数量
RETRIEVAL_TOP_K=3
# 置信度阈值（低于此值触发低置信度错误）
RETRIEVAL_SCORE_THRESHOLD=0.65

# ===== 超时配置 =====
# AI Chain 超时（秒）
AI_CHAIN_TIMEOUT=2.5

# ===== 派单与上传 =====
# 派单系统推送地址（可选）
DISPATCH_API_URL=
# 附件上传目录（相对项目根目录或绝对路径）
UPLOAD_DIR=./uploads

# ===== 文档路径 =====
# 原始文档根目录（知识库源文件所在目录，默认 ai/docs/）
DOCS_PATH=
# 媒体文件 URL 前缀（用于前端渲染图片）
MEDIA_URL_PREFIX=/api/media

# ===== 企业微信 Smartsheet（可选）=====
# 接入企业微信智能表格，用于项目数据查询/更新
WECOM_CORPID=
WECOM_CORPSECRET=
WECOM_DOCID=
WECOM_SHEET_ID=

# ===== GPU 配置（可选）=====
# CUDA_VISIBLE_DEVICES=0,1  # 指定使用的 GPU 设备
