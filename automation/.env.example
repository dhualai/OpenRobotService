# Automation Test Platform Environment Variables

# Runtime Environment (dev / staging / production)
AUTOMATION_ENV=dev

# Backend API
API_BASE_URL=http://localhost:8000
API_TIMEOUT=30

# MySQL (for data validation)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=test
MYSQL_PASSWORD=
MYSQL_DATABASE=openrobot

# Redis (for cache validation)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Qdrant (for vector search validation)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# DeepSeek API (for AI evaluation)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# WeChat (for mock testing)
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
WECHAT_APP_ID=

# Playwright (UI testing)
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
