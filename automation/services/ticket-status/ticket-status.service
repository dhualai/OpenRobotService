[Unit]
Description=Ticket status read-only API for CI
After=network-online.target

[Service]
Type=simple
User=ticket-api
Group=ticket-api
WorkingDirectory=/opt/ticket-status
EnvironmentFile=/opt/ticket-status/ticket-status.env
ExecStart=/opt/ticket-status/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8099 --workers 2
Restart=always
RestartSec=3
# 只读服务：尽量收窄权限
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ticket-status

[Install]
WantedBy=multi-user.target
