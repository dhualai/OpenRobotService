# Copy to .env on this machine only. Never commit. Never ship in a release image.
POSTGRES_USER=topo
POSTGRES_PASSWORD=
POSTGRES_DB=topo
DATABASE_URL=postgresql+psycopg://topo:CHANGE_ME@127.0.0.1:5432/topo
SESSION_SECRET=
TOPO_CONTENT_KEY=
# 32-byte keys as urlsafe base64 (see packaging/gen-secrets.py)
DEBUG=true
OPENAPI_ENABLED=true
BIND_HOST=127.0.0.1
BIND_PORT=8767
# Auth pack site URL (the page users open). Local Vite:
# TOPO_PUBLIC_URL=http://127.0.0.1:5173
# 内网停更时填写新站点。留空则文档写入照常。也可只在服务器写 /home/topo/migrated.url。
# TOPO_MIGRATED_URL=http://125.122.97.107:18080
# USP 测试管家（admin license 只放服务端，不要写进前端）
USP_TEST_BASE_URL=http://10.10.10.202:9200
# USP_TEST_ADMIN_LICENSE=
