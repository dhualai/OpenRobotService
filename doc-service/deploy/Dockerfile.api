FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-server rsync ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /var/run/sshd /app/app /app/www /app/bin /opt/payload /opt/install \
 && useradd -m -s /bin/bash topo \
 && passwd -l topo \
 && chown -R topo:topo /app /home/topo

COPY requirements-api.txt /tmp/requirements-api.txt
RUN pip install --no-cache-dir -r /tmp/requirements-api.txt \
 && rm -f /tmp/requirements-api.txt

COPY sshd_config /etc/ssh/sshd_config
COPY entrypoint-api.sh /usr/local/bin/entrypoint-api.sh
COPY update.sh /opt/payload/bin/update.sh
RUN chmod 755 /usr/local/bin/entrypoint-api.sh /opt/payload/bin/update.sh

WORKDIR /app
EXPOSE 22 8767
ENTRYPOINT ["/usr/local/bin/entrypoint-api.sh"]
