# 使用说明：
#   1. cp .env.example .env 后按需修改，服务启动时会自动读取（相对进程工作目录）。
#   2. 真实环境变量优先级更高，.env 只补不覆盖——服务器用 systemd EnvironmentFile
#      或容器 --env-file 注入时，即使目录里残留 .env 也不会被覆盖。
#   3. 不想读文件：设 WXPAY_DOTENV=0；想指定其他路径：设 WXPAY_DOTENV_PATH=/etc/wxpay/wxpay.env
#   4. .env 已在 .gitignore 中，切勿提交。

# ===== 服务自身 =====
WXPAY_LISTEN_ADDR=:9100
WXPAY_LOG_LEVEL=INFO
# 优雅关闭等待时长：必须大于 WXPAY_WRITE_TIMEOUT，否则在途请求会被打断
WXPAY_SHUTDOWN_TIMEOUT=30
WXPAY_READ_TIMEOUT=15
WXPAY_WRITE_TIMEOUT=15

# ===== 内部调用鉴权（与 FastAPI 侧 WXPAY_INTERNAL_TOKEN 保持一致） =====
WXPAY_INTERNAL_TOKEN=change-me-to-a-long-random-string

# ===== 微信支付商户参数 =====
WXPAY_MCH_ID=1900009191
WXPAY_APP_ID=wxf636efh567hg4356
WXPAY_CERT_SERIAL_NO=1DDE55AD98Exxxxxxxxxx
WXPAY_PRIVATE_KEY_PATH=./testdata/mock_platform_private_key.pem

# APIv3 密钥：32 字符，用于回调解密（泄露等于回调内容可被解密）
WXPAY_API_V3_KEY=GV6l2Um7dN4EfCT6hFkhHVcKX7m1PTk8

# ===== 微信支付公钥（官方推荐，长期有效） =====
# ⚠️ 必须与下方 MOCK_PUBLIC_KEY_ID 完全一致（区分大小写的字符串等值比较）。
#    不一致时所有接口都会失败：wxpay: no public key for serial "PUB_KEY_ID_MOCK000000001"
WXPAY_PUBLIC_KEY_ID=PUB_KEY_ID_MOCK000000001
WXPAY_PUBLIC_KEY_PATH=./testdata/mock_platform_public_key.pem

# ===== 本地联调：把微信 API 指向 mock 服务 =====
# ⚠️ 非空即生效，请求将不再发往微信支付！生产必须删除该行。
# 留空 = 使用官方地址 https://api.mch.weixin.qq.com
# WXPAY_API_BASE_URL=http://127.0.0.1:9200

# ===== 商家转账 =====
# 公网 HTTPS 站点根地址（不含路径），最终 notify_url = {base}/wxpay/notify/transfer
WXPAY_NOTIFY_BASE_URL=http://127.0.0.1:9100
WXPAY_TRANSFER_SCENE_ID=1000
WXPAY_USER_RECV_PERCEPTION=现金奖励
WXPAY_MAX_TRANSFER_AMOUNT_FEN=20000
WXPAY_API_TIMEOUT=10

# ===== 下游 FastAPI =====
WXPAY_FASTAPI_BASE_URL=http://127.0.0.1:8400
# ⚠️ 内部令牌双向共用，必须与上方 WXPAY_INTERNAL_TOKEN 取同一个值：
#    · 本服务用它推回调给 FastAPI，FastAPI 用其 WXPAY_INTERNAL_TOKEN 校验；
#    · FastAPI 调本服务时用其 WXPAY_INTERNAL_TOKEN，本服务用 WXPAY_INTERNAL_TOKEN 校验。
#    三者不一致会导致一侧 401。
WXPAY_FASTAPI_TOKEN=change-me-to-a-long-random-string
# 必须 <= 4 秒，保证回调 5 秒内应答
WXPAY_FASTAPI_NOTIFY_TIMEOUT=3

# ===== 本地 mock 服务（cmd/mockwx，仅在联调时使用） =====
# 生成密钥：go run ./cmd/mockwx -genkey ./testdata
# 启动：    go run ./cmd/mockwx
MOCK_LISTEN_ADDR=:9200
MOCK_PRIVATE_KEY_PATH=testdata/mock_platform_private_key.pem
MOCK_PUBLIC_KEY_ID=PUB_KEY_ID_MOCK000000001
# 留空则自动复用上面的 WXPAY_API_V3_KEY（回调密文必须用同一把钥匙）
MOCK_API_V3_KEY=
# 建单后的初始状态：WAIT_USER_CONFIRM / ACCEPTED / PROCESSING
MOCK_INITIAL_STATE=WAIT_USER_CONFIRM
# 是否建单后自动推进到终态并推送回调（1=开启），用于免手动操作跑通全流程
MOCK_AUTO_SETTLE=0
MOCK_SETTLE_DELAY_SEC=3
MOCK_SETTLE_STATE=SUCCESS
MOCK_NOTIFY_TIMEOUT_SEC=5
