# ===== 数据库 =====
# 格式：mysql+pymysql://<用户名>:<密码>@<主机>:<端口>/<库名>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/openrobotservice?charset=utf8mb4

# ===== JWT =====
JWT_SECRET=change-me-to-a-random-long-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 应用 =====
APP_ENV=dev
SECRET_KEY=
FRONTEND_BASE_URL=http://127.0.0.1:5173
BACKEND_CORS_ORIGINS=["*"]

# ===== 管理员默认账号 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=usp2026@EP

# ===== 微信服务号（留空则进入开发降级模式）=====
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
WECHAT_OAUTH_REDIRECT=https://your.domain/api/wechat/oauth/callback

# ===== 微信模板消息 ID =====
TPL_ASSIGN_ID=
TPL_COMMENT_ID=
TPL_ESCALATE_ID=

# ===== 微信支付（独立 Go 微服务 wxpay-service，见 docs/微信支付接入技术方案.md）=====
# 商户私钥 / APIv3 密钥 / 微信支付公钥全部在 Go 侧配置，本服务只持有业务参数与内部令牌。
WXPAY_ENABLED=False                      # 总开关；关闭时提现接口返回 503，联调须置 True
WXPAY_SERVICE_URL=http://127.0.0.1:9100  # wxpay-service 内网地址
# 内部鉴权令牌，FastAPI <-> Go 双向共用：
#   · 本服务调 Go：携带本令牌，Go 用其 WXPAY_INTERNAL_TOKEN 校验
#   · Go 调本服务：Go 携带其 WXPAY_FASTAPI_TOKEN，本服务用本令牌校验
#   ⇒ 三处必须是同一个值：本项 = Go 的 WXPAY_INTERNAL_TOKEN = Go 的 WXPAY_FASTAPI_TOKEN
WXPAY_INTERNAL_TOKEN=change-me-to-a-long-random-string
WXPAY_MCH_ID=                            # 商户号，仅用于前端调起确认页参数回传
WXPAY_APP_ID=                            # 留空则回退 WECHAT_APP_ID
WXPAY_TRANSFER_SCENE_ID=1000
WXPAY_USER_RECV_PERCEPTION=现金奖励
WXPAY_REWARD_EXPIRE_DAYS=30              # 奖励有效期（天），超期未提现即失效
WXPAY_MIN_WITHDRAW_FEN=100               # 最低提现金额（分）
WXPAY_MAX_TRANSFER_FEN=20000             # 单笔上限（分），须与 Go 侧 WXPAY_MAX_TRANSFER_AMOUNT_FEN 一致
WXPAY_RECONCILE_INTERVAL_MINUTES=10      # 兜底查单 / 一致性巡检周期（分钟）
WXPAY_SERVICE_TIMEOUT=10.0

# ===== AI 服务配置 =====
AI_SERVICE_URL=http://localhost:8401

# ===== AI 数据分析平台 · LLM 配置 =====
AI_MODEL_URL=https://api.deepseek.com
AI_MODEL_NAME=deepseek-v4-flash
AI_API_KEY=

# --- 通用 LLM 配置 ---
AI_SERVICE_PROVIDER=openai
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_MODEL_NAME=deepseek-v4-flash
LLM_TEMPERATURE=0.7
LLM_STREAM=false

# --- 自定义 AI 接口 ---
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_PATH=/api/ask

# ===== 对象存储 (MinIO) =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=wxing
MINIO_SECRET_KEY=15911Lm!
MINIO_BUCKET=usp-helpdesk
MINIO_SECURE=True
# 对象存储请求路径前缀：本地直连 MinIO 留空；生产经 nginx 网关代理时设为 "/minio-api"
MINIO_API_PREFIX=

# ===== 评论附件存储 =====
COMMENT_BUCKET=helpdesk-comment

# ===== 资源分享/下载预签名 URL 有效期（分钟）=====
RESOURCE_DOWNLOAD_URL_EXPIRES_MINUTES=3

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== MQTT =====
MQTT_BROKER=
MQTT_PORT=8084
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=DAS_MQTT_WX
MQTT_TOPIC_REQUEST=ai/request
MQTT_TOPIC_RESPONSE=ai/response

# ===== Meilisearch 全文检索 =====
MEILI_ENABLED=true
MEILI_HOST_URL=http://localhost:7700
MEILI_MASTER_KEY=

# ===== 外部任务源（禅道）=====
TASK_SOURCES_ENABLED=[]
ZENTAO_BASE_URL=
ZENTAO_ACCOUNT=
ZENTAO_PASSWORD=
ZENTAO_VERIFY_SSL=true
ZENTAO_PROJECT_IDS=
HELPDESK_SYNC_API_KEY=
# 设备报警提醒对外接口 API Key（URL ?key= 方式鉴权，供内部其他后端服务调用）
ROBOT_ALARM_API_KEY=

# ===== 建议通知用户 =====
SUGGESTIONS_NOTIFICATION_USERS=[]