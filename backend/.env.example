# ===== 数据库 =====
# 格式：mysql+pymysql://<用户名>:<密码>@<主机>:<端口>/<库名>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/your_database?charset=utf8mb4

# ===== Docker 数据库配置（使用 docker-compose 时）=====
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=helpdesk
MYSQL_USER=admin
MYSQL_PASSWORD=123456
MYSQL_PORT=3306

# ===== JWT =====
JWT_SECRET=change-me-to-a-random-long-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ===== 应用 =====
APP_ENV=dev
FRONTEND_BASE_URL=http://127.0.0.1:5173
API_PORT=8000

# ===== 微信服务号（留空则进入开发降级模式）=====
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_AES_KEY=
WECHAT_OAUTH_REDIRECT=https://your.domain/api/wechat/oauth/callback

# ===== 微信模板消息 ID =====
TPL_ASSIGN_ID=
TPL_COMMENT_ID=
TPL_ESCALATE_ID=

# ===== MinIO 对象存储 =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=helpdesk
MINIO_SECURE=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
COMMENT_BUCKET=helpdesk-comment

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== AI 服务 =====
AI_MODEL_URL=http://localhost:8005
AI_MODEL_NAME=qwen2
AI_API_KEY=

# ===== MQTT =====
MQTT_BROKER=
MQTT_PORT=8084
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=DAS_MQTT_WX

# ===== 外部服务 =====
USER_CENTER_BASE_URL=http://localhost:8400
AUTH_SERVICE_URL=http://localhost:8400
DATA_SERVICE_URL=http://localhost:8002
DATA_DEBUG_SERVICE_URL=http://localhost:8012
FAQ_SERVER_URL=http://localhost:8005

# ===== 管理员账号（首次启动自动创建）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# ===== 通知配置 =====
SUGGESTIONS_NOTIFICATION_USERS=

# ===== 密钥 =====
SECRET_KEY=change-me-to-a-random-long-secret