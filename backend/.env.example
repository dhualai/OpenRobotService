# ===== 数据库 =====
# 格式：mysql+pymysql://<用户名>:<密码>@<主机>:<端口>/<库名>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/openrobotservice?charset=utf8mb4

# ===== JWT =====
JWT_SECRET=change-me-to-a-random-long-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 应用 =====
APP_ENV=dev
SECRET_KEY=
FRONTEND_BASE_URL=http://127.0.0.1:5173
BACKEND_CORS_ORIGINS=["*"]

# ===== 管理员默认账号 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=usp2026@EP

# ===== 微信服务号（留空则进入开发降级模式）=====
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
WECHAT_OAUTH_REDIRECT=https://your.domain/api/wechat/oauth/callback

# ===== 微信模板消息 ID =====
TPL_ASSIGN_ID=
TPL_COMMENT_ID=
TPL_ESCALATE_ID=

# ===== AI 服务配置 =====
AI_SERVICE_URL=http://localhost:8010

# ===== AI 数据分析平台 · LLM 配置 =====
AI_MODEL_URL=https://api.deepseek.com
AI_MODEL_NAME=deepseek-v4-flash
AI_API_KEY=

# --- 通用 LLM 配置 ---
AI_SERVICE_PROVIDER=openai
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_MODEL_NAME=deepseek-v4-flash
LLM_TEMPERATURE=0.7
LLM_STREAM=false

# --- 自定义 AI 接口 ---
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_PATH=/api/ask

# ===== 对象存储 (MinIO) =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=helpdesk
MINIO_SECURE=false

# ===== 评论附件存储 =====
COMMENT_BUCKET=helpdesk-comment

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== MQTT =====
MQTT_BROKER=
MQTT_PORT=8084
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=DAS_MQTT_WX
MQTT_TOPIC_REQUEST=ai/request
MQTT_TOPIC_RESPONSE=ai/response

# ===== Meilisearch 全文检索 =====
MEILI_ENABLED=true
MEILI_HOST_URL=http://localhost:7700
MEILI_MASTER_KEY=

# ===== 外部任务源（禅道）=====
TASK_SOURCES_ENABLED=[]
ZENTAO_BASE_URL=
ZENTAO_ACCOUNT=
ZENTAO_PASSWORD=
ZENTAO_VERIFY_SSL=true
ZENTAO_PROJECT_IDS=
HELPDESK_SYNC_API_KEY=

# ===== 建议通知用户 =====
SUGGESTIONS_NOTIFICATION_USERS=[]