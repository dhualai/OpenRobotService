# ===== 数据库 =====
# 格式：mysql+pymysql://<用户名>:<密码>@<主机>:<端口>/<库名>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/openrobotservice?charset=utf8mb4

# ===== JWT =====
JWT_SECRET=change-me-to-a-random-long-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ===== 应用 =====
APP_ENV=dev
FRONTEND_BASE_URL=http://127.0.0.1:5173

# ===== 微信服务号（留空则进入开发降级模式）=====
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_AES_KEY=
WECHAT_OAUTH_REDIRECT=https://your.domain/api/wechat/oauth/callback

# ===== 微信模板消息 ID =====
TPL_ASSIGN_ID=
TPL_COMMENT_ID=
TPL_ESCALATE_ID=

# ===== AI 数据分析平台 · LLM 配置 =====
# 提供商: deepseek / qwen / glm / siliconflow / openai_compatible
LLM_PROVIDER=deepseek

# --- DeepSeek ---
# 官网: https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- 通义千问 (Qwen) ---
# 官网: https://dashscope.aliyun.com
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# --- 智谱 GLM ---
# 官网: https://open.bigmodel.cn
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# --- SiliconFlow (硅基流动，聚合多款开源模型) ---
# 官网: https://siliconflow.cn
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- 通用 OpenAI 兼容接口（自定义提供商）---
# 当 LLM_PROVIDER=openai_compatible 时使用以下配置
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- 分析引擎参数 ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
