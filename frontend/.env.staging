# 预发（staging）环境配置（vite build --mode staging 时加载）
# 用于上线前验证，通常接近生产：建议开启微信登录以验证真实授权流程。
# 若 staging 用独立的测试公众号，请填对应的 AppID。

# 认证守卫：false=未登录按下方配置跳转；true=关闭守卫（预发建议 false，验证真实登录）
VITE_DISABLE_AUTH_GUARD=false

# ── 微信相关可配置项 ──────────────────────────────────────────────
# 预发通常开启微信登录，验证 OAuth 流程（如用测试公众号则填测试号 AppID）
VITE_WECHAT_LOGIN_ENABLED=true
# 是否启用微信 JS-SDK 初始化：按需开启
VITE_WECHAT_JSSDK_ENABLED=true
# 微信公众号 AppID（预发若复用生产号则与 .env.production 一致；或用测试号）
VITE_WECHAT_APP_ID=
# 授权作用域：snsapi_base（静默）| snsapi_userinfo
VITE_WECHAT_OAUTH_SCOPE=snsapi_base
# OAuth 回调路径（需与后端路由、公众号网页授权域名一致）
VITE_WECHAT_REDIRECT_PATH=/api/wechat/callback
# 完整 OAuth 回调地址（可选）：填了直接作 redirect_uri；留空则自动用 origin + 上面路径推导
VITE_WECHAT_REDIRECT_URI=
# 微信分享卡片默认缩略图（公网 HTTPS；/t/app 为预发 base，域名须与安全域名一致）
VITE_WECHAT_SHARE_IMG_URL=https://usp.ep-zl.com/t/app/share-thumb.png
