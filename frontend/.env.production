# 生产环境配置（vite build --mode production 时加载，优先级高于 .env.local）
# 说明：本文件可被提交到仓库（APP_ID 等本身为公开信息）；敏感项（AppSecret）只配在后端。

# 认证守卫：false=未登录按下方配置跳转（微信 OAuth 或 /login）；true=关闭守卫（生产务必 false）
VITE_DISABLE_AUTH_GUARD=false

# ── 微信相关可配置项 ──────────────────────────────────────────────
# 是否启用微信网页授权登录跳转：true=未登录跳微信 OAuth；false=跳 /login 账密页
VITE_WECHAT_LOGIN_ENABLED=true
# 是否启用微信 JS-SDK 初始化：true=动态加载 jweixin 并拉取签名；false=跳过（需要时再开）
VITE_WECHAT_JSSDK_ENABLED=false
# 微信公众号 AppID（必填，替换为你的生产公众号 AppID）
VITE_WECHAT_APP_ID=wx7c6fcd3acf3db8bd
# 授权作用域：snsapi_base（静默，仅 openid，默认）| snsapi_userinfo（昵称头像）
VITE_WECHAT_OAUTH_SCOPE=snsapi_base
# OAuth 回调路径（需与后端路由、公众号网页授权域名一致）
VITE_WECHAT_REDIRECT_PATH=/api/wechat/callback
# 完整 OAuth 回调地址：生产 nginx 仅转发 /p/api/* 到后端，故必须带 /p 前缀，否则微信回调用 404
VITE_WECHAT_REDIRECT_URI=https://usp.ep-zl.com/p/api/wechat/callback
